{
  "Filter": {"prefix":"filter", "body":"| filter ${1:field} = ${2:value}", "description":"Filter rows"},
  "Alter": {"prefix":"alter", "body":"| alter ${1:field} = ${2:expression}", "description":"Create or replace a field"},
  "Count": {"prefix":"comp-count", "body":"| comp count() as ${1:row_count} by ${2:field}", "description":"Count rows by a field"}
}
